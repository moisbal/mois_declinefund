# Review-only placeholders. Do not commit a populated copy.
# For an offline UI preview, use .env.demo.example instead.
NEXT_PUBLIC_SUPABASE_URL=https://<TEST_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<TEST_PUBLIC_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<TEST_SERVER_SERVICE_ROLE_KEY>
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_FINANCIAL_LEDGER_UI=true
TARGET_ENV=TEST
TEST_PROJECT_REF=<VERIFIED_TEST_PROJECT_REF>
PROD_PROJECT_REF=<PRODUCTION_REF_FOR_DENY_COMPARISON_ONLY>
# Read-only preparation: do not enable transaction writes by default.
LEDGER_MODE=disabled

# Optional: only for separately authorized TEST audit scripts.
TEST_SUPABASE_SERVICE_ROLE_KEY=<TEST_SERVER_SERVICE_ROLE_KEY>
TEST_DATABASE_URL=<TEST_DATABASE_CONNECTION_STRING>
UAT_ADMIN_A_EMAIL=<TEST_ADMIN_A_EMAIL>
UAT_ADMIN_A_PASSWORD=<TEST_ADMIN_A_PASSWORD>
UAT_ADMIN_B_EMAIL=<TEST_ADMIN_B_EMAIL>
UAT_ADMIN_B_PASSWORD=<TEST_ADMIN_B_PASSWORD>
UAT_LOCAL_A_EMAIL=<TEST_LOCAL_A_EMAIL>
UAT_LOCAL_A_PASSWORD=<TEST_LOCAL_A_PASSWORD>
UAT_LOCAL_B_EMAIL=<TEST_LOCAL_B_EMAIL>
UAT_LOCAL_B_PASSWORD=<TEST_LOCAL_B_PASSWORD>
UAT_LOCAL_C_EMAIL=<TEST_LOCAL_C_EMAIL>
UAT_LOCAL_C_PASSWORD=<TEST_LOCAL_C_PASSWORD>
